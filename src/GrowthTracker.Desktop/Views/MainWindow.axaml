<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GrowthTracker.Desktop.ViewModels"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="GrowthTracker.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="Personal Growth Tracker"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Background="{DynamicResource BgBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseDialogCommand}" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="Auto,*">
    <!-- Sidebar: 240px, collapses to 72px (UI Design §3.1) -->
    <Border Name="Sidebar" Grid.Column="0" Width="{Binding SidebarWidth}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,20,16,8" Spacing="10">
          <Button Name="ToggleSidebarButton" Command="{Binding ToggleSidebarCommand}"
                  Background="#2563EB" Foreground="White" Width="36" Height="36" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  ToolTip.Tip="Thu gọn / mở rộng">
            <mi:MaterialIcon Kind="TrendingUp" Width="20" Height="20" />
          </Button>
          <StackPanel VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}">
            <TextBlock Text="Growth Tracker" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Personal Development" Classes="caption" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <Button Name="ToggleThemeButton" DockPanel.Dock="Bottom" Margin="16" Classes="icon"
                Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Đổi giao diện sáng / tối">
          <mi:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" />
        </Button>

        <TextBlock DockPanel.Dock="Top" Text="ĐIỀU HƯỚNG" Classes="eyebrow" Margin="24,16,0,4"
                   IsVisible="{Binding !IsSidebarCollapsed}" />

        <ListBox Name="NavList" Classes="nav" ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNavItem}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14"
                           IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <!-- Auto-update (TDD §8.3): shown once an update is downloaded; installing waits for the user's restart. -->
      <Border Name="UpdateBanner" DockPanel.Dock="Top" Background="#142563EB" BorderBrush="#402563EB"
              BorderThickness="0,0,0,1" Padding="24,10" IsVisible="{Binding Updates.IsReady}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <mi:MaterialIcon Kind="Update" Width="20" Height="20" Foreground="#2563EB" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Updates.BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="primary" Content="Khởi động lại" Command="{Binding Updates.RestartCommand}" />
        </Grid>
      </Border>
      <ContentControl Name="PageHost" Content="{Binding CurrentPage}" />
    </DockPanel>

    <!-- Dialog overlay (DialogService): dims the window and blocks input behind the dialog. -->
    <Panel Name="DialogHost" Grid.ColumnSpan="2" IsVisible="{Binding HasDialog}">
      <Border Background="#73000000" />
      <Border Classes="card" Padding="0" Margin="32" MaxWidth="680" MinWidth="460"
              HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 12 24 -4 #33000000">
        <ContentControl Content="{Binding CurrentDialog}" />
      </Border>
    </Panel>
  </Grid>
</Window>
