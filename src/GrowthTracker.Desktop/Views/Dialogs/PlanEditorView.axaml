<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GrowthTracker.Desktop.ViewModels.Dialogs"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="GrowthTracker.Desktop.Views.Dialogs.PlanEditorView"
             x:DataType="vm:PlanEditorViewModel">
  <DockPanel Width="620">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,20,16,0">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" Classes="headline" />
        <TextBlock Text="{Binding GoalName}" Classes="caption" />
      </StackPanel>
      <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" VerticalAlignment="Top">
        <mi:MaterialIcon Kind="Close" Width="18" Height="18" />
      </Button>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="24,8,24,20">
      <Border Background="#142563EB" CornerRadius="8" Padding="12,8"
              IsVisible="{Binding PreviewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <mi:MaterialIcon Kind="CalendarCheckOutline" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Top" Margin="0,2,0,0" />
          <TextBlock Name="PreviewText" Grid.Column="1" Text="{Binding PreviewText}" FontSize="13" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <TextBlock Name="ErrorText" Text="{Binding ErrorMessage}" Classes="error"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="ghost" Content="Huỷ" Command="{Binding CancelCommand}" />
        <Button Name="SubmitButton" Classes="primary" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer MaxHeight="560">
      <StackPanel Spacing="16" Margin="24,16">
        <StackPanel>
          <TextBlock Text="Tên kế hoạch" Classes="field-label" />
          <TextBox Name="NameBox" Text="{Binding Name}" PlaceholderText="Ví dụ: Listening 20 phút/ngày (Tech Pods)" />
        </StackPanel>

        <!-- Plan type (BRD §5.2) -->
        <StackPanel>
          <TextBlock Text="Cách đo lường" Classes="field-label" />
          <ListBox Name="TypeList" ItemsSource="{x:Static vm:PlanEditorViewModel.PlanTypes}" SelectedItem="{Binding SelectedType}"
                   IsEnabled="{Binding CanChangeTypeAndStart}"
                   Background="Transparent">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="5" ColumnSpacing="8" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#1F2563EB" />
                <Setter Property="BorderBrush" Value="#2563EB" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:PlanTypeOption">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="#2563EB" />
                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Hint}" FontSize="10" Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Name="FixedFieldsNote" Text="{Binding FixedFieldsNote}" Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0"
                     IsVisible="{Binding IsEditing}" />
        </StackPanel>

        <!-- Main input changes with the plan type -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding ShowsTarget}">
          <StackPanel>
            <TextBlock Text="Target mỗi buổi" Classes="field-label" />
            <NumericUpDown Name="TargetBox" Value="{Binding TargetValue}" Minimum="0" Maximum="100000" Increment="5" FormatString="0.##" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Đơn vị" Classes="field-label" />
            <TextBox Text="{Binding TargetUnit}" PlaceholderText="phút, trang, từ…" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="8" IsVisible="{Binding ShowsFrequency}">
          <TextBlock Text="Số buổi mỗi tuần" Classes="field-label" />
          <NumericUpDown Name="FrequencyBox" Value="{Binding FrequencyPerWeek}" Minimum="1" Maximum="7" Increment="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
          <CheckBox Content="Chọn ngày cụ thể trong tuần" IsChecked="{Binding UseSpecificDays}" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowsCriteria}">
          <TextBlock Text="Tiêu chí hoàn thành" Classes="field-label" />
          <ItemsControl ItemsSource="{Binding Criteria}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                  <mi:MaterialIcon Kind="CheckboxBlankOutline" Width="16" Height="16" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="icon"
                          Command="{Binding $parent[UserControl].((vm:PlanEditorViewModel)DataContext).RemoveCriterionCommand}"
                          CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="CriterionBox" Text="{Binding NewCriterion}" PlaceholderText="Ví dụ: Nộp hồ sơ đăng ký thi">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCriterionCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="ghost" Content="Thêm" Command="{Binding AddCriterionCommand}" />
          </Grid>
        </StackPanel>

        <!-- Schedule -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowsDayToggles}">
          <TextBlock Text="Ngày trong tuần" Classes="field-label" />
          <ItemsControl ItemsSource="{Binding DayToggles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:WeekDayToggle">
                <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsChecked}" Width="44" Height="36"
                              HorizontalContentAlignment="Center" CornerRadius="8" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <StackPanel>
            <TextBlock Text="Bắt đầu" Classes="field-label" />
            <CalendarDatePicker Name="StartBox" SelectedDate="{Binding DurationStart}" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanChangeTypeAndStart}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Kết thúc" Classes="field-label" />
            <CalendarDatePicker Name="EndBox" SelectedDate="{Binding DurationEnd}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <StackPanel>
            <TextBlock Text="Giờ ưu tiên (không bắt buộc)" Classes="field-label" />
            <TimePicker SelectedTime="{Binding PreferredTime}" ClockIdentifier="24HourClock" MinuteIncrement="5"
                        HorizontalAlignment="Stretch" MinWidth="0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Độ khó" Classes="field-label" />
            <ComboBox ItemsSource="{x:Static vm:PlanEditorViewModel.Difficulties}" SelectedItem="{Binding SelectedDifficulty}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:DifficultyOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <Grid>
          <StackPanel>
            <TextBlock Text="Milestone" Classes="field-label" />
            <ComboBox Name="MilestoneBox" ItemsSource="{Binding Milestones}" SelectedItem="{Binding SelectedMilestone}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:MilestoneOption">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
