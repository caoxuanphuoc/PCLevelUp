<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GrowthTracker.Desktop.ViewModels.Pages"
             xmlns:p="using:GrowthTracker.Desktop.Presentation"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="GrowthTracker.Desktop.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="20" Margin="32,28" MaxWidth="880" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" Classes="screen-title" />

      <Border Classes="card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Lĩnh vực (Area)" Classes="card-title" />
              <TextBlock Text="Mỗi lĩnh vực có một màu cố định trên toàn ứng dụng. Lưu trữ để ẩn khỏi danh sách chọn; mục tiêu cũ vẫn giữ nguyên."
                         Classes="body" TextWrapping="Wrap" />
            </StackPanel>
            <Button Name="AddAreaButton" Grid.Column="1" Classes="primary" VerticalAlignment="Top" Command="{Binding AddAreaCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                <TextBlock Text="Thêm lĩnh vực" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="{Binding ActionError}" Classes="error"
                     IsVisible="{Binding ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ItemsControl Name="AreaList" ItemsSource="{Binding Areas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:AreaRowViewModel">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"
                        Opacity="{Binding !IsArchived, Converter={x:Static p:Converters.ActiveOpacity}}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Ellipse Width="14" Height="14" Fill="{Binding ColorBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding GoalText}" Classes="caption" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost" Content="Sửa" Command="{Binding EditCommand}" />
                    <Button Grid.Column="3" Classes="ghost" Content="{Binding ArchiveText}" Command="{Binding ToggleArchiveCommand}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="Chạy nền &amp; thông báo" Classes="card-title" />
            <TextBlock Text="Nhắc nhở và các tác vụ hằng ngày (chuyển buổi quá hạn, quét rủi ro) chỉ chạy khi ứng dụng đang mở hoặc đang ở khay hệ thống."
                       Classes="body" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Nhắc nhở trước giờ ưu tiên" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ReminderText}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="RemindersToggle" Grid.Column="1" IsChecked="{Binding RemindersEnabled}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Ẩn xuống khay khi đóng cửa sổ" FontWeight="SemiBold" />
              <TextBlock Text="Nút đóng (X) chỉ ẩn ứng dụng để nhắc nhở vẫn hoạt động. Thoát hẳn bằng menu ở biểu tượng khay."
                         Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="CloseToTrayToggle" Grid.Column="1" IsChecked="{Binding CloseToTray}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Khởi động cùng hệ điều hành" FontWeight="SemiBold" />
              <TextBlock Text="Mở sẵn dưới khay khi đăng nhập máy, để không bỏ lỡ nhắc nhở." Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="StartWithOsToggle" Grid.Column="1" IsChecked="{Binding StartWithOs}" OnContent="" OffContent="" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Auto-update (TDD §8.3) -->
      <Border Name="UpdatesCard" Classes="card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="Cập nhật" Classes="card-title" />
              <TextBlock Text="{Binding Updates.VersionText}" FontWeight="SemiBold" />
              <TextBlock Name="UpdateStatus" Text="{Binding Updates.StatusText}" Classes="caption" TextWrapping="Wrap" />
              <ProgressBar Value="{Binding Updates.DownloadPercent}" Maximum="100" Height="4" MinWidth="0"
                           IsVisible="{Binding Updates.IsBusy}" IsIndeterminate="{Binding Updates.IsChecking}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Name="CheckUpdatesButton" Classes="ghost" Content="Kiểm tra cập nhật"
                      Command="{Binding Updates.CheckNowCommand}" IsEnabled="{Binding Updates.CanCheck}" />
              <Button Classes="primary" Content="Khởi động lại" Command="{Binding Updates.RestartCommand}"
                      IsVisible="{Binding Updates.IsReady}" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Tự động kiểm tra cập nhật" FontWeight="SemiBold" />
              <TextBlock Text="Kiểm tra GitHub Releases khi mở ứng dụng và mỗi 12 giờ, tải sẵn bản mới ở nền. Chỉ cài khi bạn khởi động lại."
                         Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="AutoUpdateToggle" Grid.Column="1" IsChecked="{Binding AutoCheckUpdates}" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Nhận bản beta" FontWeight="SemiBold" />
              <TextBlock Text="Dùng thử tính năng mới sớm hơn. Bản beta có thể còn lỗi; dữ liệu luôn được sao lưu trước khi nâng cấp."
                         Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="BetaToggle" Grid.Column="1" IsChecked="{Binding IncludePrerelease}" OnContent="" OffContent="" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Giao diện, sao lưu và khôi phục dữ liệu sẽ có trong các bản tiếp theo." Classes="caption" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
