<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GrowthTracker.Desktop.ViewModels.Pages"
             x:Class="GrowthTracker.Desktop.Views.Pages.TodayView"
             x:DataType="vm:TodayViewModel">
  <StackPanel Spacing="8">
    <TextBlock Classes="screen-title" Text="{Binding Title}" />
    <TextBlock Classes="body" Text="{Binding Subtitle}" />
  </StackPanel>
</UserControl>
